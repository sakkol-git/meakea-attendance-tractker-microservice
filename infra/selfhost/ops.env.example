# Copy outside Git to an operator-owned mode 600 file; set HRFLOW_OPS_CONFIG to that path.
HRFLOW_ROOT=/absolute/path/to/hrflow
HRFLOW_TARGET_ID=acer-nitro-5
HRFLOW_MODE=production
COMPOSE_PROJECT_NAME=hrflow-selfhost
HRFLOW_EDGE_BIND_IP=127.0.0.1
HRFLOW_BROWSER_ORIGIN=https://hrflow.test
HRFLOW_AUTH_ISSUER=https://identity.hrflow.test
POSTGRES_PASSWORD=replace-with-private-value
HRFLOW_DB_RUNTIME_USER=identity_runtime
HRFLOW_DB_RUNTIME_PASSWORD=replace-with-different-private-value
HRFLOW_DB_MIGRATION_USER=identity_migrator
HRFLOW_DB_MIGRATION_PASSWORD=replace-with-different-private-value
HRFLOW_DB_BACKUP_USER=identity_backup
HRFLOW_DB_BACKUP_PASSWORD=replace-with-different-private-value
HRFLOW_SIGNING_KEYS_DIR=/protected/hrflow/signing-keys
HRFLOW_PRIVATE_FILES_DIR=/protected/hrflow/files
HRFLOW_BACKUP_MOUNT=/mnt/hrflow-backup
HRFLOW_BACKUP_MAPPER=hrflow_backup
HRFLOW_RELEASE_IMAGES='hrflow-selfhost-api-gateway:latest hrflow-selfhost-identity-org:latest hrflow-selfhost-web:latest postgres:18-alpine confluentinc/cp-kafka:8.2.0 confluentinc/cp-schema-registry:8.2.0 caddy:2.9-alpine'
# Set only for the intended command and remove after the drill:
# HRFLOW_BACKUP_CONFIRM=acer-nitro-5
# HRFLOW_DEPLOY_CONFIRM=acer-nitro-5
# HRFLOW_SCRATCH_DB=hrflow_restore_20261026_01
# HRFLOW_RESTORE_CONFIRM=hrflow_restore_20261026_01
