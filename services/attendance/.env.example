# Local development only; copy values into .env (the supplied .env is blank).
# Spring loads this as Java properties: no export, quotes, or inline comments.
# Exported process environment takes precedence. Never commit a filled .env.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8102
MANAGEMENT_ADDRESS=127.0.0.1
MANAGEMENT_PORT=9102
LOG_LEVEL=INFO
HRFLOW_AUTH_JWKS_URI=http://localhost:8101/.well-known/jwks.json
HRFLOW_AUTH_ISSUER=hrflow-local

DB_URL=jdbc:postgresql://localhost:5432/hrflow
DB_USERNAME=attendance_app
# REQUIRED: provision the matching non-owner runtime role and fill locally.
DB_PASSWORD=
DB_POOL_MAX_SIZE=5
# REQUIRED: separate schema-owning migration role; do not make runtime role an owner.
FLYWAY_USERNAME=attendance_migrator
FLYWAY_PASSWORD=

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081
HRFLOW_ATTENDANCE_ORG_CONSUMER_ENABLED=false
HRFLOW_ATTENDANCE_ORG_BOOTSTRAP_TIMEOUT_MS=60000
# Enable after session schema registration, migrations V3-V6 and private metadata-only job grants.
HRFLOW_ATTENDANCE_RELAY_ENABLED=false
HRFLOW_ATTENDANCE_JOB_USER=attendance_job
HRFLOW_ATTENDANCE_JOB_PASSWORD=

HRFLOW_ATTENDANCE_LEAVE_CONSUMER_ENABLED=false

# Enable with the separately verified daily relay/consumer path.
HRFLOW_ATTENDANCE_DAILY_STATUS_ENABLED=false

HRFLOW_ATTENDANCE_DAILY_WORKER_ENABLED=false

HRFLOW_ATTENDANCE_CUTOFF_ENABLED=false
HRFLOW_ATTENDANCE_CUTOFF_CONSUMER_ENABLED=false

# Recalculate observed daily dates after typed holiday changes; uses the private attendance job role.
HRFLOW_ATTENDANCE_HOLIDAY_FANOUT_ENABLED=false
# Requeue observed current/future days after organization shift or assignment changes.
HRFLOW_ATTENDANCE_SCHEDULE_FANOUT_ENABLED=false

# Enable only after canonical source/retry/DLQ topics and Avro registration.
HRFLOW_EVENTS_RECOVERY_ENABLED=false
