# Local development only; copy values into .env (the supplied .env is blank).
# Spring loads this as Java properties: no export, quotes, or inline comments.
# Exported process environment takes precedence. Never commit a filled .env.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8105
MANAGEMENT_ADDRESS=127.0.0.1
MANAGEMENT_PORT=9105
LOG_LEVEL=INFO
HRFLOW_AUTH_JWKS_URI=http://localhost:8101/.well-known/jwks.json
HRFLOW_AUTH_ISSUER=hrflow-local

DB_URL=jdbc:postgresql://localhost:5432/hrflow
DB_USERNAME=notification_app
# REQUIRED: provision the matching non-owner runtime role and fill locally.
DB_PASSWORD=
DB_POOL_MAX_SIZE=5
# REQUIRED: separate schema-owning migration role; do not make runtime role an owner.
FLYWAY_USERNAME=notification_migrator
FLYWAY_PASSWORD=

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# Requires retained org.employee.v1 replay and verified linked-account role snapshots.
NOTIFICATION_DOMAIN_CONSUMER_ENABLED=false
NOTIFICATION_REFERENCE_BOOTSTRAP_TIMEOUT_MS=60000

# Enable only after canonical source/retry/DLQ topics and Avro registration.
HRFLOW_EVENTS_RECOVERY_ENABLED=false
