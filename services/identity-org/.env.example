# Local development only; copy values into .env (the supplied .env is blank).
# Spring loads this as Java properties: no export, quotes, or inline comments.
# Exported process environment takes precedence. Never commit a filled .env.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8101
MANAGEMENT_ADDRESS=127.0.0.1
MANAGEMENT_PORT=9101
LOG_LEVEL=INFO

DB_URL=jdbc:postgresql://localhost:5432/hrflow
DB_USERNAME=identity_org_app
# REQUIRED: provision the matching non-owner runtime role and fill locally.
DB_PASSWORD=
DB_POOL_MAX_SIZE=5
# REQUIRED: separate schema-owning migration role; do not make runtime role an owner.
FLYWAY_USERNAME=identity_org_migrator
FLYWAY_PASSWORD=

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081
# Enable only after the private UUID-only job role, topics and Schema Registry subject exist.
HRFLOW_ORG_RELAY_ENABLED=false
HRFLOW_ORG_RELAY_POLL_MS=250
HRFLOW_DB_JOB_USER=
HRFLOW_DB_JOB_PASSWORD=

# Authentication policy. Browser cookies stay Secure; use the documented local TLS setup.
HRFLOW_AUTH_ISSUER=hrflow-local
HRFLOW_AUTH_BROWSER_ORIGIN=https://hrflow.test
HRFLOW_AUTH_SECURE_COOKIES=true
# Browser-visible path of the auth routes. Direct service calls use /auth;
# gateway deployments must override this with /api/v1/auth.
HRFLOW_AUTH_REFRESH_COOKIE_PATH=/auth
HRFLOW_AUTH_ACCOUNT_ATTEMPT_LIMIT=5
HRFLOW_AUTH_SOURCE_ATTEMPT_LIMIT=50
HRFLOW_AUTH_KEY_DIRECTORY=/keys
HRFLOW_AUTH_LOCAL_BOOTSTRAP=false
HRFLOW_AUTH_DEV_PASSWORD=

# Enable only after canonical source/retry/DLQ topics and Avro registration.
HRFLOW_EVENTS_RECOVERY_ENABLED=false
