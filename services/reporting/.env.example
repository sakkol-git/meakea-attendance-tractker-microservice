# Local development only; copy values into .env (the supplied .env is blank).
# Spring loads this as Java properties: no export, quotes, or inline comments.
# Exported process environment takes precedence. Never commit a filled .env.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8106
MANAGEMENT_ADDRESS=127.0.0.1
MANAGEMENT_PORT=9106
LOG_LEVEL=INFO
HRFLOW_AUTH_JWKS_URI=http://localhost:8101/.well-known/jwks.json
HRFLOW_AUTH_ISSUER=hrflow-local

DB_URL=jdbc:postgresql://localhost:5432/hrflow
DB_USERNAME=reporting_app
# REQUIRED: provision the matching non-owner runtime role and fill locally.
DB_PASSWORD=
DB_POOL_MAX_SIZE=5
# REQUIRED: separate schema-owning migration role; do not make runtime role an owner.
FLYWAY_USERNAME=reporting_migrator
FLYWAY_PASSWORD=

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081
# Live typed session consumer; legacy POJO listeners remain disabled.
REPORTING_SESSION_CONSUMER_ENABLED=false
REPORTING_LEAVE_CONSUMER_ENABLED=false
REPORTING_EMPLOYEE_CONSUMER_ENABLED=false
REPORTING_EMPLOYEE_BOOTSTRAP_TIMEOUT_MS=60000
REPORTING_KAFKA_CONSUMER_ENABLED=false
# Private durable directory on a filesystem supporting atomic rename.
REPORTING_EXPORT_STORAGE_DIR=/protected/hrflow/reporting-exports
REPORTING_EXPORT_ROW_CAP=10000
REPORTING_EXPORT_WORKER_ENABLED=false
REPORTING_JOB_USER=reporting_job
REPORTING_JOB_PASSWORD=

REPORTING_DAILY_CONSUMER_ENABLED=false

# Replay typed request.workflow.v1 before exposing request CSV source.
REPORTING_REQUEST_CONSUMER_ENABLED=false
REPORTING_REQUEST_BOOTSTRAP_TIMEOUT_MS=60000

# Enable only after canonical source/retry/DLQ topics and Avro registration.
HRFLOW_EVENTS_RECOVERY_ENABLED=false
