{
  "type": "record",
  "name": "AttendanceDailyFact",
  "namespace": "com.hrflow.contracts.attendance",
  "doc": "Full daily snapshot on accepted attendance.daily-status.v1, key tenantId:employeeId. Positive per-employee/day revision. Preserves calendar type, evidence references and review independently. User-approved UAT timing and no-auto-refund decisions are recorded in the decision register. No device/location or leave reason is included.",
  "fields": [
    {
      "name": "eventId",
      "type": "string"
    },
    {
      "name": "type",
      "type": "string"
    },
    {
      "name": "schemaVersion",
      "type": "int",
      "default": 1
    },
    {
      "name": "tenantId",
      "type": "string"
    },
    {
      "name": "aggregateId",
      "type": "string"
    },
    {
      "name": "aggregateVersion",
      "type": "long"
    },
    {
      "name": "occurredAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "correlationId",
      "type": "string"
    },
    {
      "name": "causationId",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "employeeId",
      "type": "string"
    },
    {
      "name": "workDate",
      "type": {
        "type": "int",
        "logicalType": "date"
      }
    },
    {
      "name": "timezone",
      "type": "string"
    },
    {
      "name": "clockIn",
      "type": [
        "null",
        {
          "type": "long",
          "logicalType": "timestamp-millis"
        }
      ],
      "default": null
    },
    {
      "name": "clockOut",
      "type": [
        "null",
        {
          "type": "long",
          "logicalType": "timestamp-millis"
        }
      ],
      "default": null
    },
    {
      "name": "expectedStart",
      "type": [
        "null",
        {
          "type": "long",
          "logicalType": "timestamp-millis"
        }
      ],
      "default": null
    },
    {
      "name": "expectedEnd",
      "type": [
        "null",
        {
          "type": "long",
          "logicalType": "timestamp-millis"
        }
      ],
      "default": null
    },
    {
      "name": "status",
      "type": "string"
    },
    {
      "name": "dayType",
      "type": "string"
    },
    {
      "name": "late",
      "type": "boolean"
    },
    {
      "name": "earlyDeparture",
      "type": "boolean"
    },
    {
      "name": "reviewRequired",
      "type": "boolean"
    },
    {
      "name": "finalized",
      "type": "boolean"
    },
    {
      "name": "openSession",
      "type": "boolean"
    },
    {
      "name": "reviewReason",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "minutesWorked",
      "type": [
        "null",
        "int"
      ],
      "default": null
    },
    {
      "name": "minutesLate",
      "type": "int"
    },
    {
      "name": "shiftId",
      "type": "string"
    },
    {
      "name": "shiftRevision",
      "type": "long"
    },
    {
      "name": "leaveReferences",
      "type": {
        "type": "array",
        "items": {
          "type": "record",
          "name": "DailyLeaveReference",
          "fields": [
            {
              "name": "leaveId",
              "type": "string"
            },
            {
              "name": "revision",
              "type": "long"
            },
            {
              "name": "portion",
              "type": "string"
            },
            {
              "name": "workRecorded",
              "type": [
                "null",
                "boolean"
              ],
              "default": null,
              "doc": "Explicit attendance-owner overlap with this leave portion using the captured shift. Null means legacy unknown; consumers must not infer a conflict from a generic review flag."
            }
          ]
        }
      }
    },
    {
      "name": "sessionReferences",
      "type": {
        "type": "array",
        "items": {
          "type": "record",
          "name": "DailySessionReference",
          "fields": [
            {
              "name": "sessionId",
              "type": "string"
            },
            {
              "name": "revision",
              "type": "long"
            }
          ]
        }
      }
    }
  ]
}
