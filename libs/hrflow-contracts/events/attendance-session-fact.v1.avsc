{
  "type": "record",
  "name": "AttendanceSessionFact",
  "namespace": "com.hrflow.contracts.attendance",
  "doc": "Full effective TAP/MANUAL session snapshot on attendance.session.v1, keyed tenantId:employeeId. Aggregate revision is the committed session optimistic revision plus one. No raw device/location evidence is included.",
  "fields": [
    {"name":"eventId","type":"string"},
    {"name":"type","type":"string"},
    {"name":"schemaVersion","type":"int","default":1},
    {"name":"tenantId","type":"string"},
    {"name":"aggregateId","type":"string"},
    {"name":"aggregateVersion","type":"long"},
    {"name":"occurredAt","type":{"type":"long","logicalType":"timestamp-millis"}},
    {"name":"correlationId","type":"string"},
    {"name":"causationId","type":["null","string"],"default":null},
    {"name":"employeeId","type":"string"},
    {"name":"workDate","type":{"type":"int","logicalType":"date"}},
    {"name":"timezone","type":"string"},
    {"name":"clockIn","type":{"type":"long","logicalType":"timestamp-millis"}},
    {"name":"clockOut","type":["null",{"type":"long","logicalType":"timestamp-millis"}],"default":null},
    {"name":"state","type":"string"},
    {"name":"scheduledStart","type":{"type":"long","logicalType":"timestamp-millis"}},
    {"name":"scheduledEnd","type":{"type":"long","logicalType":"timestamp-millis"}},
    {"name":"graceMinutes","type":"int"},
    {"name":"source","type":"string","doc":"TAP for explicit check-in/out; MANUAL for an approved correction. Inference remains gated separately."}
  ]
}
